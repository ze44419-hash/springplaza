# ===== Supabase (Project Settings → API) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only — used by /api/admin/users to create accounts. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ===== App (اختياري) =====
NEXT_PUBLIC_CAFE_NAME="سبرينج بلازا كافيه"
NEXT_PUBLIC_CURRENCY_LABEL=ج.م
NEXT_PUBLIC_RECEIPT_FOOTER="شكرًا لزيارتكم!"
# CORS: اتركه فاضي (same-origin). حطه فقط لو دومين تاني هيكلم /api — مثال: https://cafe.example.com
APP_ORIGIN=
